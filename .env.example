# Local settings. Never commit .env or real credentials.
DEEPSEEK_API_KEY=replace-with-your-key
HARNESS2_SOLVER_MODEL=deepseek/deepseek-flash
HARNESS2_IMPROVER_MODEL=deepseek/deepseek-flash
HARNESS2_JUDGE_MODEL=deepseek-flash
# JobBench judging supports this OpenAI-compatible endpoint; use the same key.
HARNESS2_JUDGE_BASE_URL=https://api.deepseek.com/v1
HARNESS2_JUDGE_API_KEY=replace-with-your-key
HARNESS2_RUNS_DIR=runs/deepseek-flash
# Explicit model metadata avoids relying on a stale OpenCode model catalog.
OPENCODE_CONFIG_CONTENT={"provider":{"deepseek":{"npm":"@ai-sdk/deepseek","options":{"baseURL":"https://api.deepseek.com/v1","apiKey":"{env:DEEPSEEK_API_KEY}"},"models":{"deepseek-flash":{"name":"DeepSeek V4.1 Flash","limit":{"context":1048576,"output":393216},"reasoning":true,"tool_call":true,"interleaved":{"field":"reasoning_content"}}}}}}
